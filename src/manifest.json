{
  "manifest_version": 3,
  "name": "Easy TickTick",
  "description": "Easily create a new TickTick task with a link to the current page!",
  "version": "1.4.3",
  "background": {
    "service_worker": "/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "24": "icons/icon24.png",
      "32": "icons/icon32.png"
    },
    "default_title": "Create Task",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png"
  },
  "options_page": "options.html",
  "side_panel": {
    "default_path": "popup.html"
  },
  "permissions": [
    "notifications",
    "contextMenus",
    "tabs",
    "activeTab",
    "storage",
    "sessions",
    "identity",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "key": ""
}